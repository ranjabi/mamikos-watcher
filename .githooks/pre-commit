#!/bin/sh
# Blocks the commit if staged Go code is unformatted or fails go vet.
# Enable once per clone: git config core.hooksPath .githooks

staged=$(git diff --cached --name-only --diff-filter=ACMR -- '*.go')
[ -z "$staged" ] && exit 0

unformatted=$(gofmt -l $staged)
if [ -n "$unformatted" ]; then
	echo "pre-commit: these files need gofmt (run: gofmt -w <file>):"
	echo "$unformatted"
	exit 1
fi

if ! go vet ./...; then
	echo "pre-commit: go vet failed"
	exit 1
fi
