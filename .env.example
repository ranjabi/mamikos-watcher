# Comma-separated Mamikos property URLs to watch (required)
MAMIKOS_URLS=https://mamikos.com/room/kost-kota-jakarta-selatan-kost-campur-eksklusif-kost-singgahsini-dstudio-mrt-haji-nawi-tipe-a-cilandak-jakarta-selatan-2,https://mamikos.com/room/kost-kota-jakarta-selatan-kost-campur-eksklusif-kost-haji-nawi-residence-26a-tipe-vvip-cilandak-jakarta-selatan,https://mamikos.com/room/kost-jakarta-selatan-kost-campur-eksklusif-kost-cipete-residence-tipe-superior-cilandak-jakarta-selatan-2

# How often to check, as a Go duration (e.g. 1m, 15m, 1h). Default: 30m
FETCH_INTERVAL=30m

# Per-request timeout. Default: 20s
HTTP_TIMEOUT=20s

# User-Agent header sent with each request. Default: a desktop Chrome string
# USER_AGENT=

# debug | info | warn | error. Default: info
LOG_LEVEL=info
